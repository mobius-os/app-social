# syntax=docker/dockerfile:1
FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SOCIAL_DATA_DIR=/data

RUN groupadd --gid 1000 social \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin social \
    && mkdir -p /data /srv/social \
    && chown 1000:1000 /data

COPY requirements-public.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock \
    && rm /tmp/requirements.lock

WORKDIR /srv/social
COPY common_protocol.py common_public.py common_transport.py net_utils.py \
     service_io.py public_host.py public_host_factory.py ./

ARG SOURCE_SHA
RUN printf '%s\n' "$SOURCE_SHA" | grep -Eq '^[0-9a-f]{40}$' \
    || { echo 'SOURCE_SHA must be exactly 40 lowercase hexadecimal characters' >&2; exit 1; }; \
    printf '%s\n' "$SOURCE_SHA" > SOCIAL_SOURCE_SHA \
    && chown -R root:root /srv/social \
    && chmod -R a-w /srv/social

USER 1000:1000
EXPOSE 8080
CMD ["uvicorn", "public_host:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
